<Project Sdk="Godot.NET.Sdk/4.7.0">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifiers>android-arm64;android-x64;ios-arm64;iossimulator-arm64</RuntimeIdentifiers>
		<Nullable>enable</Nullable>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<InvariantGlobalization>true</InvariantGlobalization>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Configurations>Debug;ExportDebug;ExportRelease</Configurations>
	</PropertyGroup>
	<!-- NativeAOT Configuration for Android and iOS -->
	<PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'android' Or '$(GodotTargetPlatform)' == 'ios' ">
		<PublishAot>true</PublishAot>
		<DisableUnsupportedError>true</DisableUnsupportedError>
		<PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
		<IsCreator>false</IsCreator>
		<IsMobile>true</IsMobile>
		<DefineConstants>$(DefineConstants);CLIENT</DefineConstants>
	</PropertyGroup>
	<!--
		NativeAOT's Unix targets normally discover clang from PATH. Godot is often
		launched from Explorer/Android Studio without the NDK toolchain directory in
		PATH, even though the configured Android SDK contains it. Resolve the tools
		directly so editor exports and command-line exports behave identically.
	-->
	<PropertyGroup Condition="'$(GodotTargetPlatform)' == 'android' And $([MSBuild]::IsOSPlatform('Windows'))">
		<BrickVerseAndroidSdkRoot Condition="'$(ANDROID_HOME)' != ''">$(ANDROID_HOME)</BrickVerseAndroidSdkRoot>
		<BrickVerseAndroidSdkRoot Condition="'$(BrickVerseAndroidSdkRoot)' == '' And '$(ANDROID_SDK_ROOT)' != ''">$(ANDROID_SDK_ROOT)</BrickVerseAndroidSdkRoot>
		<BrickVerseAndroidSdkRoot Condition="'$(BrickVerseAndroidSdkRoot)' == '' And '$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\Android\Sdk</BrickVerseAndroidSdkRoot>
		<!-- Override this property when upgrading the NDK used by the export preset. -->
		<BrickVerseAndroidNdkVersion Condition="'$(BrickVerseAndroidNdkVersion)' == ''">30.0.15729638</BrickVerseAndroidNdkVersion>
		<BrickVerseAndroidNdkBin>$(BrickVerseAndroidSdkRoot)\ndk\$(BrickVerseAndroidNdkVersion)\toolchains\llvm\prebuilt\windows-x86_64\bin</BrickVerseAndroidNdkBin>
		<!-- Also covers the NativeAOT target's later `ar` and `llvm-objcopy` probes. -->
		<Path>$(BrickVerseAndroidNdkBin);$(Path)</Path>
		<!-- NativeAOT validates these with where.exe, which rejects absolute paths. -->
		<CppCompilerAndLinker>clang</CppCompilerAndLinker>
		<ObjCopyName>llvm-objcopy</ObjCopyName>
	</PropertyGroup>
	<UsingTask TaskName="BrickVerseSetEnvironmentVariable"
		TaskFactory="RoslynCodeTaskFactory"
		AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Name ParameterType="System.String" Required="true" />
			<Value ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Code Type="Fragment" Language="cs"><![CDATA[
				System.Environment.SetEnvironmentVariable(Name, Value);
			]]></Code>
		</Task>
	</UsingTask>
	<Target Name="ConfigureBrickVerseAndroidNativeAotToolchain"
		BeforeTargets="SetupOSSpecificProps"
		Condition="'$(GodotTargetPlatform)' == 'android' And $([MSBuild]::IsOSPlatform('Windows'))">
		<Error Condition="!Exists('$(BrickVerseAndroidNdkBin)\clang.exe')"
			Text="Android NDK clang was not found at '$(BrickVerseAndroidNdkBin)'. Install NDK $(BrickVerseAndroidNdkVersion), or pass /p:BrickVerseAndroidNdkVersion=&lt;installed-version&gt;." />
		<!-- Exec tasks inherit the MSBuild process environment, not the MSBuild Path property. -->
		<BrickVerseSetEnvironmentVariable Name="PATH" Value="$(BrickVerseAndroidNdkBin);$([System.Environment]::GetEnvironmentVariable('PATH'))" />
	</Target>
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
		<DirectPInvoke Include="Luau.VM" />
		<DirectPInvoke Include="Luau.Compiler" />
		<NativeLibrary Include="native/luau/ios/libLuau.VM.a" />
		<NativeLibrary Include="native/luau/ios/libLuau.Compiler.a" />
		<NativeLibrary Include="native/luau/ios/libLuau.Ast.a" />
		<NativeLibrary Include="native/luau/ios/libLuau.Bytecode.a" />
		<NativeLibrary Include="native/luau/ios/libLuau.Common.a" />
	</ItemGroup>
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'iossimulator-arm64'">
		<DirectPInvoke Include="Luau.VM" />
		<DirectPInvoke Include="Luau.Compiler" />
		<NativeLibrary Include="native/luau/iossimulator-arm64/libLuau.VM.a" />
		<NativeLibrary Include="native/luau/iossimulator-arm64/libLuau.Compiler.a" />
		<NativeLibrary Include="native/luau/iossimulator-arm64/libLuau.Ast.a" />
		<NativeLibrary Include="native/luau/iossimulator-arm64/libLuau.Bytecode.a" />
		<NativeLibrary Include="native/luau/iossimulator-arm64/libLuau.Common.a" />
	</ItemGroup>
	<!--
		The Android NativeAOT runtime loads its cryptography PAL dynamically when
		HttpClient first performs TLS. Godot packages the main AOT image but does
		not automatically retain this companion library from the runtime pack.
		Without it, HTTPS aborts the entire process from a .NET worker thread.
		Retain the ABI-matched companion library for both production arm64 and
		the x86_64 Android emulator target.
	-->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'android-arm64'">
		<None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.nativeaot.android-arm64\10.0.9\runtimes\android-arm64\native\libSystem.Security.Cryptography.Native.Android.so"
			Link="libSystem.Security.Cryptography.Native.Android.so"
			CopyToOutputDirectory="Always"
			CopyToPublishDirectory="Always" />
	</ItemGroup>
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'android-x64'">
		<None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.nativeaot.android-x64\10.0.9\runtimes\android-x64\native\libSystem.Security.Cryptography.Native.Android.so"
			Link="libSystem.Security.Cryptography.Native.Android.so"
			CopyToOutputDirectory="Always"
			CopyToPublishDirectory="Always" />
	</ItemGroup>
	<ItemGroup>
		<!-- Trimmer ignores, this is currently required for Godot NativeAOT projects -->
		<TrimmerRootAssembly Include="$(TargetName)" />
		<TrimmerRootAssembly Include="GodotSharp" />
		<!-- Luau.VM -->
		<None Include="native/Luau.VM/windows/Luau.VM.dll" Link="Luau.VM.dll" Condition="'$(GodotTargetPlatform)' == 'windows'" CopyToOutputDirectory="Always" />
		<None Include="native/Luau.VM/macos/Luau.VM.dylib" Link="Luau.VM.dylib" Condition="'$(GodotTargetPlatform)' == 'macos'" CopyToOutputDirectory="Always" />
		<None Include="native/Luau.VM/linux/Luau.VM.so" Link="Luau.VM.so" Condition="'$(GodotTargetPlatform)' == 'linuxbsd'" CopyToOutputDirectory="Always" />
		<None Include="native/Luau.VM/android/libLuau.VM.so" Link="libLuau.VM.so" Condition="'$(GodotTargetPlatform)' == 'android'" CopyToOutputDirectory="Always" />
		<!-- Luau.Compiler -->
		<None Include="native/Luau.Compiler/windows/Luau.Compiler.dll" Link="Luau.Compiler.dll" Condition="'$(GodotTargetPlatform)' == 'windows'" CopyToOutputDirectory="Always" />
		<None Include="native/Luau.Compiler/macos/Luau.Compiler.dylib" Link="Luau.Compiler.dylib" Condition="'$(GodotTargetPlatform)' == 'macos'" CopyToOutputDirectory="Always" />
		<None Include="native/Luau.Compiler/linux/Luau.Compiler.so" Link="Luau.Compiler.so" Condition="'$(GodotTargetPlatform)' == 'linuxbsd'" CopyToOutputDirectory="Always" />
		<None Include="native/Luau.Compiler/android/libLuau.Compiler.so" Link="libLuau.Compiler.so" Condition="'$(GodotTargetPlatform)' == 'android'" CopyToOutputDirectory="Always" />
		<!-- Discord Game SDK -->
		<None Include="native/discord/windows/discord_game_sdk.dll" Link="discord_game_sdk.dll" Condition="'$(GodotTargetPlatform)' == 'windows'" CopyToOutputDirectory="Always" />
		<None Include="native/discord/macos/discord_game_sdk.dylib" Link="discord_game_sdk.dylib" Condition="'$(GodotTargetPlatform)' == 'macos'" CopyToOutputDirectory="Always" />
		<None Include="native/discord/linux/discord_game_sdk.so" Link="discord_game_sdk.so" Condition="'$(GodotTargetPlatform)' == 'linuxbsd'" CopyToOutputDirectory="Always" />
		<!-- Package References -->
		<PackageReference Include="QRCoder" Version="1.8.0" />
		<PackageReference Include="MemoryPack" Version="1.21.4" />
		<PackageReference Include="Semver" Version="3.0.0" />
		<PackageReference Include="TurboXml" Version="2.0.3" />
		<PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
		<PackageReference Include="Humanizer.Core" Version="3.0.10" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\BrickVerse.SourceGen\BrickVerse.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<EmbeddedResource Include="assets\profanity.txt" LogicalName="BrickVerse.Assets.profanity.txt" />
	</ItemGroup>
	<!-- ExportRelease configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
		<DefineConstants>$(DefineConstants);CLIENT</DefineConstants>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<DebugType>None</DebugType>
		<DebugSymbols>False</DebugSymbols>
	</PropertyGroup>
	<!-- Build Target Configurations -->
	<PropertyGroup>
		<!-- Do not overwrite platform values assigned above. Android/iOS set
		     IsMobile=true before this group is evaluated; resetting it here
		     excluded every scripts/mobile/**/*.cs file from NativeAOT exports. -->
		<IsCreator Condition="'$(IsCreator)' == ''">false</IsCreator>
		<IsMobile Condition="'$(IsMobile)' == ''">false</IsMobile>
		<IsCreator Condition="'$(BV_BUILD_TARGET)' == 'CREATOR'">true</IsCreator>
		<IsMobile Condition="'$(BV_BUILD_TARGET)' == 'MOBILE'">true</IsMobile>
	</PropertyGroup>
	<!-- Production Flag -->
	<PropertyGroup Condition="'$(BV_PRODUCTION)' == 'TRUE'">
		<DefineConstants>$(DefineConstants);PRODUCTION</DefineConstants>
	</PropertyGroup>
	<!-- Server Docker flag -->
	<PropertyGroup Condition="'$(BV_DOCKER)' == 'TRUE'">
		<DefineConstants>$(DefineConstants);BV_DOCKER</DefineConstants>
	</PropertyGroup>
	<!-- ExportDebug build (Build all) -->
	<PropertyGroup Condition="'$(Configuration)' == 'ExportDebug' Or '$(Configuration)' == 'Debug'">
		<DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
		<IsCreator>true</IsCreator>
		<IsMobile>true</IsMobile>
		<DebugType>Full</DebugType>
		<DebugSymbols>True</DebugSymbols>
	</PropertyGroup>
	<!-- Strip out Creator -->
	<ItemGroup Condition="'$(IsCreator)' != 'true'">
		<Compile Remove="scripts/creator/**/*.cs" />
		<Compile Remove="scripts/datamodel/creator/**/*.cs" />
	</ItemGroup>
	<!-- Strip out Mobile -->
	<ItemGroup Condition="'$(IsMobile)' != 'true'">
		<Compile Remove="scripts/mobile/**/*.cs" />
	</ItemGroup>
	<!-- Strip out Executor -->
	<ItemGroup Condition="'$(Configuration)' == 'ExportRelease'">
		<Compile Remove="scripts/client/executor/**/*.cs" />
	</ItemGroup>
	<!-- Strip out Datamodel Tests -->
	<ItemGroup Condition="'$(Configuration)' != 'Debug' And '$(Configuration)' != 'ExportDebug'">
		<Compile Remove="scripts/datamodeltest/**/*.cs" />
	</ItemGroup>
	<!-- Remove android temporary .cs files -->
	<ItemGroup>
		<Compile Remove="android/build/**/*.cs" />
	</ItemGroup>
	<!-- CREATOR Constant -->
	<PropertyGroup Condition="'$(IsCreator)' == 'true'">
		<DefineConstants>$(DefineConstants);CREATOR</DefineConstants>
	</PropertyGroup>
	<!-- MOBILE Constant -->
	<PropertyGroup Condition="'$(IsMobile)' == 'true'">
		<DefineConstants>$(DefineConstants);MOBILE</DefineConstants>
	</PropertyGroup>
	<!-- BV_PRIVATE_API Constant, This is used to link with BrickVerse's Private API Components -->
	<PropertyGroup Condition="'$(BV_PRIVATE_API)' == 'TRUE'">
		<DefineConstants>$(DefineConstants);BV_PRIVATE_API</DefineConstants>
	</PropertyGroup>
	<!-- Delete PDB files after publish, we don't want leaks happening TヮT -->
	<Target Name="DeleteFiles" AfterTargets="Publish">
		<ItemGroup>
			<FilesToDelete Include="$(PublishDir)*.pdb;" />
		</ItemGroup>
		<Delete Files="@(FilesToDelete)">
			<Output TaskParameter="DeletedFiles" ItemName="FilesDeleted" />
		</Delete>
		<Message Text="Deleted PDB files: @(FilesDeleted)" Importance="high" />
	</Target>
</Project>
