[node name="Spacer" type="Control" parent="Surface/Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="Download" type="Button" parent="Surface/Margin/Layout"]
layout_mode = 2
size_flags_horizontal = 0
text = "Download installer instead"
flat = true

[node name="Actions" type="HBoxContainer" parent="Surface/Margin/Layout"]
layout_mode = 2
