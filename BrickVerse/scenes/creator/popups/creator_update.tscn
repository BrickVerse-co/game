[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/creator/ui/popups/CreatorUpdatePopup.cs" id="1"]

[sub_resource type="StyleBoxFlat" id="Surface"]
bg_color = Color(0.039, 0.052, 0.071, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.12, 0.18, 0.25, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="CreatorUpdate" type="Window" node_paths=PackedStringArray("_version", "_neverShow", "_later", "_update", "_download")]
title = "Creator Update Available"
size = Vector2i(560, 330)
min_size = Vector2i(500, 300)
transient = true
exclusive = false
script = ExtResource("1")
_version = NodePath("Surface/Margin/Layout/Version")
_neverShow = NodePath("Surface/Margin/Layout/NeverShow")
_later = NodePath("Surface/Margin/Layout/Actions/Later")
_update = NodePath("Surface/Margin/Layout/Actions/Update")
_download = NodePath("Surface/Margin/Layout/Download")

[node name="Surface" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("Surface")

[node name="Margin" type="MarginContainer" parent="Surface"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Layout" type="VBoxContainer" parent="Surface/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Surface/Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 23
text = "A new Creator version is available"

[node name="Description" type="Label" parent="Surface/Margin/Layout"]
layout_mode = 2
text = "Update or repair Creator through the BrickVerse Installer. Save your current work before updating."
autowrap_mode = 2

[node name="Version" type="Label" parent="Surface/Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.73, 0.9, 1)
text = "Installed\nAvailable"

[node name="NeverShow" type="CheckBox" parent="Surface/Margin/Layout"]
layout_mode = 2
