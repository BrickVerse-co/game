[sub_resource type="Shader" id="qr_round_shader"]
code = "shader_type canvas_item;
uniform float corner_radius : hint_range(0.0, 0.25) = 0.065;
void fragment() {
    vec2 edge = abs(UV - vec2(0.5)) - vec2(0.5 - corner_radius);
    float distance_to_edge = length(max(edge, vec2(0.0))) - corner_radius;
    vec4 color = texture(TEXTURE, UV);
    color.a *= 1.0 - smoothstep(0.0, max(fwidth(distance_to_edge), 0.001), distance_to_edge);
    COLOR = color;
}
"

[sub_resource type="ShaderMaterial" id="qr_round_material"]
